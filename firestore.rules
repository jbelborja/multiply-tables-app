rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/results/{resultId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['score', 'total', 'mode', 'tables', 'date', 'mistakes', 'reviewedOperations', 'practiceType'])
        && request.resource.data.keys().hasAll(['score', 'total', 'mode', 'tables', 'date'])
        && request.resource.data.score is int
        && request.resource.data.total is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.total > 0
        && request.resource.data.mode in ['typed', 'choice']
        && request.resource.data.tables is list
        && request.resource.data.date is timestamp
        && (!request.resource.data.keys().hasAny(['mistakes'])
          || (request.resource.data.mistakes is list && request.resource.data.mistakes.size() <= 10))
        && (!request.resource.data.keys().hasAny(['reviewedOperations'])
          || (request.resource.data.reviewedOperations is list && request.resource.data.reviewedOperations.size() <= 10))
        && (!request.resource.data.keys().hasAny(['practiceType'])
          || request.resource.data.practiceType in ['standard', 'errors']);
      allow update, delete: if false;
    }
  }
}
